{
  "api": {
    "name": "Developer Analytics API",
    "version": "v1_beta",
    "basePath": "/developer/analytics/v1_beta",
    "description": "Monitor API usage and rate limits for your application",
    "documentation": "https://developer.ebay.com/api-docs/developer/analytics/overview.html",
    "scopes": ["https://api.ebay.com/oauth/api_scope"]
  },
  "endpoints": [
    {"name": "getRateLimits", "method": "GET", "path": "/rate_limit",
      "description": "Get rate limit statistics for all APIs",
      "parameters": [{"name": "api_context", "type": "string", "required": false, "description": "Filter by API context"},
        {"name": "api_name", "type": "string", "required": false, "description": "Filter by API name"}]},
    {"name": "getUserRateLimits", "method": "GET", "path": "/user_rate_limit",
      "description": "Get user-specific rate limits",
      "parameters": [{"name": "api_context", "type": "string", "required": false, "description": "Filter by API context"},
        {"name": "api_name", "type": "string", "required": false, "description": "Filter by API name"}]}
  ],
  "models": [
    {"name": "RateLimitsResponse", "properties": [{"name": "rateLimits", "type": "[RateLimit]"}]},
    {"name": "RateLimit", "properties": [
      {"name": "apiContext", "type": "string"}, {"name": "apiName", "type": "string"},
      {"name": "apiVersion", "type": "string"}, {"name": "resources", "type": "[RateLimitResource]"}]},
    {"name": "RateLimitResource", "properties": [{"name": "name", "type": "string"}, {"name": "rates", "type": "[Rate]"}]},
    {"name": "Rate", "properties": [
      {"name": "limit", "type": "integer"}, {"name": "remaining", "type": "integer"},
      {"name": "reset", "type": "string"}, {"name": "timeWindow", "type": "integer"}]}
  ],
  "hig": {
    "patterns": ["Rate Limit Dashboard", "Usage Gauges"],
    "components": ["RateLimitGauge", "UsageChart", "APIStatusList"],
    "accessibility": ["Rate limit warnings", "Usage announcements"]
  }
}
